# ==============================================================================
# Jay-QMS Server-Side Environment Variables (Netlify Functions ONLY)
# NEVER prefix server secrets with VITE_ (Vite exposes VITE_* to browser bundles)
# ==============================================================================

# 1. Google Gemini AI Copilot (Serverless Function: netlify/functions/gemini-assistant.ts)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Project Verification (Defaults to benchmark-jescode-2e842)
FIREBASE_PROJECT_ID=benchmark-jescode-2e842

# 3. Allowed CORS Origins (Comma-separated list; Netlify URL/DEPLOY_PRIME_URL auto-included)
ALLOWED_ORIGINS=https://jayqms.netlify.app

# 4. Platform Default Outbound SMTP (Used when a tenant has not configured custom SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM_NAME=Jay-QMS Notifications
SMTP_FROM_EMAIL=notifications@yourdomain.com

# 5. AES-256-GCM Master Key for Custom Tenant SMTP Password Encryption (32+ random chars or 64-char hex)
SMTP_ENCRYPTION_KEY=generate_a_strong_32_byte_hex_or_base64_secret_here

# 6. Server-Signed Cloudinary Media Uploads (netlify/functions/sign-cloudinary.ts)
CLOUDINARY_CLOUD_NAME=dpcnanmjl
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
