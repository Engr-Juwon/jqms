      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 120);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidProjectRecordUpdate(id, 120);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /permitToPour/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 120);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidProjectRecordUpdate(id, 120);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /itpPlans/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /roomPunchItems/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /takingOverCertificates/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 3)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /methodStatements/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    // --- Materials Lab, Rebar, Deliveries, Docs & Reports (Read: L1+, Create/Update: L2+, Delete: L4+) ---
    match /cubeSamples/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /steelTests/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /barCuttingSchedules/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /materialDeliveries/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /documents/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 100);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 100);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /weeklyReports/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 140);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 140);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    // --- Site Photos & 4D Construction Planner (Read: L1+, Create/Update: L2+, Delete: L3+) ---
    match /sitePhotos/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 80);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 80);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 3);
    }

    match /photos/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 80);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 80);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 3);
    }

    match /calendarEvents/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 80);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 80);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 3);
    }

    match /plannerEvents/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 2)
        && isValidProjectScopedRecord(request.resource.data, id, 80);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 2)
        && isValidProjectRecordUpdate(id, 80);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 3);
    }

    // --- Organization Master Data: Trades & Inspection Templates (Read: L1+, Create/Update: L3+, Delete: L4+) ---
    match /trades/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 3)
        && isValidCompanyScopedRecord(request.resource.data, id, 60);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 3)
        && isValidCompanyRecordUpdate(id, 60);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    match /inspectionTemplates/{id} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);
      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 3)
        && isValidCompanyScopedRecord(request.resource.data, id, 60);
      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 3)
        && isValidCompanyRecordUpdate(id, 60);
      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 4);
    }

    // --- Monotonic Document Sequence Counters (No Rollbacks / No Deletes) ---
    match /documentCounters/{counterId} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);

      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 1)
        && isValidDocumentCounter(request.resource.data, counterId);

      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidDocumentCounter(request.resource.data, counterId)
        && request.resource.data.companyId == resource.data.companyId
        && isExistingFieldImmutable('projectId')
        && isExistingFieldImmutable('prefix')
        && isExistingFieldImmutable('module')
        && isCounterFieldMonotonic('current')
        && isCounterFieldMonotonic('count')
        && isCounterFieldMonotonic('seq')
        && isCounterFieldMonotonic('sequence')
        && isCounterFieldMonotonic('lastNumber');

      allow delete: if false;
    }

    // --- Tenant-Scoped In-App Notifications ---
    match /notifications/{notifId} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);

      allow create: if isTenantMemberWithMinRole(request.resource.data.companyId, 1)
        && isValidNotification(request.resource.data, notifId);

      allow update: if isTenantMemberWithMinRole(resource.data.companyId, 1)
        && isValidNotification(request.resource.data, notifId)
        && request.resource.data.companyId == resource.data.companyId
        && isExistingFieldImmutable('id')
        && isExistingFieldImmutable('createdAt');

      allow delete: if isTenantMemberWithMinRole(resource.data.companyId, 1);
    }

    // ===============================================================
    // 3. Personal AI Copilot Conversation Sessions
    // ===============================================================

    match /ai_copilot_sessions/{sessionId} {
      allow read, delete: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && (!('companyId' in resource.data) || belongsToTenant(resource.data.companyId));

      allow create: if belongsToTenant(request.resource.data.companyId)
        && isValidAICopilotSession(request.resource.data, sessionId);

      allow update: if belongsToTenant(request.resource.data.companyId)
        && resource.data.userId == request.auth.uid
        && (!('companyId' in resource.data) || resource.data.companyId == request.resource.data.companyId)
        && isValidAICopilotSession(request.resource.data, sessionId)
        && areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
    }

    // ===============================================================
    // 4. Real-Time Team Chat & Private Channel Isolation
    // ===============================================================

    match /chatChannels/{channelId} {
      allow get: if canAccessChannelData(resource.data);

      allow list: if belongsToTenant(resource.data.companyId)
        && (
          resource.data.isPrivate == false
          || request.auth.uid in resource.data.memberIds
        );

      allow create: if belongsToTenant(request.resource.data.companyId)
        && isValidChatChannel(request.resource.data, channelId)
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid)
        && (
          (request.resource.data.get('isPrivate', false) != true
            && !(request.resource.data.get('type', 'GROUP') in ['DIRECT', 'PRIVATE']))
          || (request.resource.data.get('memberIds', []) is list
            && request.auth.uid in request.resource.data.get('memberIds', []))
        );

      allow update: if canAccessChannelData(resource.data)
        && isValidChatChannel(request.resource.data, channelId)
        && request.resource.data.companyId == resource.data.companyId
        && isExistingFieldImmutable('id')
        && isExistingFieldImmutable('createdBy')
        && isExistingFieldImmutable('createdAt');

      allow delete: if belongsToTenant(resource.data.companyId)
        && (resource.data.get('createdBy', '') == request.auth.uid || hasMinRoleLevel(4));

      // --- Channel Messages Subcollection ---
      match /messages/{messageId} {
        allow read: if canAccessParentChannel(channelId);

        allow create: if canAccessParentChannel(channelId)
          && isValidChatMessage(request.resource.data, channelId, messageId)
          && request.resource.data.senderId == request.auth.uid
          && (!('companyId' in request.resource.data) || request.resource.data.companyId == getUserCompanyId());

        allow update: if canAccessParentChannel(channelId)
          && isValidChatMessage(request.resource.data, channelId, messageId)
          && request.resource.data.senderId == resource.data.senderId
          && isExistingFieldImmutable('id')
          && isExistingFieldImmutable('channelId')
          && isExistingFieldImmutable('companyId')
          && isExistingFieldImmutable('createdAt')
          && (
            resource.data.senderId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reactions', 'pinned', 'readBy', 'status', 'updatedAt'
            ])
          );

        allow delete: if canAccessParentChannel(channelId)
          && (resource.data.senderId == request.auth.uid || hasMinRoleLevel(4));
      }
    }

    // ===============================================================
    // 5. Append-Only Immutable Enterprise Audit & Email Logs
    // ===============================================================

    match /auditLogs/{logId} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 3);

      allow create: if belongsToTenant(request.resource.data.companyId)
        && isValidAuditLog(request.resource.data, logId);

      allow update, delete: if false;
    }

    match /emailCommunications/{logId} {
      allow read: if isTenantMemberWithMinRole(resource.data.companyId, 1);

      allow create: if belongsToTenant(request.resource.data.companyId)
        && isValidEmailCommunication(request.resource.data, logId);

      allow update, delete: if false;
    }

    // ===============================================================
    // 6. Default Deny Catch-All
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
